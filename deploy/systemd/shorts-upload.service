[Unit]
Description=Shorts-Upload (Kanal de): fällige Upload-Pakete an Telegram bzw. YouTube-Upload je nach UPLOAD_MODE
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=shorts-failure@%n.service

[Service]
Type=oneshot
User=__USER__
Group=docker
WorkingDirectory=__DIR__
ExecStart=/usr/bin/docker compose run --rm job upload --channel de
TimeoutStartSec=1h
