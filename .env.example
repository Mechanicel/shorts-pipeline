# Kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env
# .env wird niemals committet.

# --- Anthropic (Skript-Erzeugung) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high – Gründlichkeit beim Faktencheck des Quelltexts
ANTHROPIC_EFFORT=high
# Günstige Vorauswahl (nur Titel + Anriss) vor dem Skript-Modell; TRIAGE_MAX Themen pro Lauf
ANTHROPIC_TRIAGE_MODEL=claude-haiku-5-5
TRIAGE_MAX=30

# --- TTS ---
# openai | espeak   (später: piper, elevenlabs)
TTS_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
# Sprechtempo (1.0 = Original, 1.25 = 25 % schneller, tonhöhenerhaltend; im Hörvergleich gewählt)
TTS_SPEED=1.25
# Stil v3 „Merkliste“ (8–12 s) spricht ruhiger
TTS_SPEED_V3=1.0

# Gestaltung neuer Videos: v2 (Hook-Tafel, ~25 s) | v3 (Merkliste, 8–12 s) | alternate (abwechselnd, für den Vergleich)
STYLE_MODE=alternate
# estimate (kostenlos, Schätzung) | whisper (OpenAI-Transkription mit Wort-Zeitstempeln, genauer)
SUBTITLE_TIMING=whisper

# --- Hintergrundvideos (optional) ---
# Key: pixabay.com/api/docs – ohne Key wird eine selbst generierte Animation genutzt
PIXABAY_API_KEY=

# Ausreißer-Recherche (CLI research): API-Key für die YouTube Data API v3 (Google Cloud Console →
# Anmeldedaten → API-Schlüssel, auf „YouTube Data API v3“ beschränken). Nicht der OAuth-Token des Kanals.
YT_API_KEY=

# --- Telegram (Review + Fehlermeldungen) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# --- YouTube ---
# manual = Upload-Pakete per Telegram, du lädst selbst hoch (Standard, solange das API-Projekt nicht
#          auditiert ist – sonst sperrt YouTube API-Uploads dauerhaft als privat)
# api    = automatischer Upload über die YouTube Data API (erst nach bestandenem Audit)
UPLOAD_MODE=manual
# Nur Anzeige: videos.insert hat einen eigenen Tagestopf (laut Google-Doku 100 Aufrufe/Tag, Reset
# Mitternacht Pacific Time). Die App blockiert NICHT vorab, sondern reagiert auf Googles Fehlermeldungen.
YT_UPLOADS_PER_DAY=100

# --- Kostenanzeige (Telegram) ---
# Claude wird exakt aus Token-Zahlen berechnet; TTS/Whisper sind Schätzwerte pro Audiominute (USD).
TTS_USD_PER_MIN=0.015
WHISPER_USD_PER_MIN=0.006
EUR_PER_USD=0.90

# --- Allgemein ---
LOG_LEVEL=INFO
DEFAULT_CHANNEL=de
